region = "ap-northeast-1"

# Slack incoming webhook URL. Leave empty to disable notifications.
# Ignored when slack_webhook_secret_arn is set.
slack_webhook_url = "https://example.com/YOUR/WEBHOOK/URL"

# Optional: retrieve the Slack webhook URL from AWS Secrets Manager instead.
# slack_webhook_secret_arn = "arn:aws:secretsmanager:REGION:ACCOUNT:secret:NAME"

# Optional: SNS topic ARN for CloudWatch alarms.
# alarm_sns_topic_arn = "arn:aws:sns:REGION:ACCOUNT:TOPIC"

# Name of the DynamoDB table created by the realtime_monitor stack.
# This default matches the default value in variables.tf.
# dynamodb_table_name = "querycost-sentinel-realtime-monitor"

# Optional overrides
# memory_size                       = 256
# timeout                           = 60
# cloudwatch_logs_retention_in_days = 365
# enable_xray_tracing               = true
# create_dashboard                  = true
# log_format                        = "text"
# create_alarm_sns_topic            = true
# enable_anomaly_detection_alarm    = true
# cost_anomaly_sigma                = 2.0
# notification_language             = "ja"
# alarm_lambda_errors_threshold     = 0
# alarm_lambda_errors_evaluation_periods = 1
# alarm_anomaly_band                = 2
# top_n                             = 10
# aws_pagination_limit              = 100
# schedule_expression               = "cron(0 9 3 * ? *)"
